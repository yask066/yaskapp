{
  "name": "yaskapp",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev -w @yaskapp/api",
    "api:build": "npm run build -w @yaskapp/api",
    "api:typecheck": "npm run typecheck -w @yaskapp/api",
    "db:bootstrap-superadmin": "npm run db:bootstrap-superadmin -w @yaskapp/api --",
    "db:migrate": "npm run db:migrate -w @yaskapp/api",
    "db:check": "npm run db:check -w @yaskapp/api",
    "poll-images:cleanup": "npm run poll-images:cleanup -w @yaskapp/api",
    "shared:build": "npm run build -w @yaskapp/shared",
    "countries:check": "node scripts/check-country-catalog.mjs",
    "api:test": "npm run countries:check && npm run test -w @yaskapp/api"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
