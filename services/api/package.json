{
  "name": "@yaskapp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:bootstrap-superadmin": "tsx src/db/bootstrap-superadmin.cli.ts",
    "db:check": "tsx src/db/check.ts",
    "avatars:cleanup": "tsx src/jobs/cleanup-avatar-objects.ts",
    "poll-images:cleanup": "tsx src/jobs/cleanup-poll-image-objects.ts",
    "notifications:cleanup": "tsx src/jobs/cleanup-notifications.ts",
    "test": "npm run db:migrate && node --import tsx --test --test-reporter spec \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.609.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/websocket": "^11.3.0",
    "@yaskapp/shared": "0.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
