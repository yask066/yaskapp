# Copy to .env.account-deletion-retention.staging and keep it out of version control.
# These read/list/delete credentials are exposed only to account-deletion-journal-exporter.
ACCOUNT_DELETION_JOURNAL_RETENTION_ACCESS_KEY_ID=replace-me
ACCOUNT_DELETION_JOURNAL_RETENTION_SECRET_ACCESS_KEY=replace-me
ACCOUNT_DELETION_JOURNAL_CHECKPOINT_RETENTION_ACCESS_KEY_ID=replace-me
ACCOUNT_DELETION_JOURNAL_CHECKPOINT_RETENTION_SECRET_ACCESS_KEY=replace-me
