# Grafana Cloud Loki URL from your stack (usually ends in /loki/api/v1/push).
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-<region>.grafana.net/loki/api/v1/push
# Use the Loki tenant/instance ID for username and a LogsWrite token for password.
GRAFANA_CLOUD_LOKI_USER=<grafana-cloud-loki-instance-id>
GRAFANA_CLOUD_LOKI_TOKEN=<grafana-cloud-logs-write-token>
