# Staging only. Copy to .env.staging, replace every placeholder, and keep the
# copied file out of Git. Account deletion stays disabled until both external
# journal stores, Object Lock, alerts, and backups have been verified.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=https://staging.example.invalid
STAGING_PUBLIC_IP=127.0.0.1

POSTGRES_USER=yaskapp
POSTGRES_PASSWORD=replace-with-a-random-secret
POSTGRES_DB=yaskapp_staging
DATABASE_URL=postgres://yaskapp:replace-with-a-random-secret@postgres:5432/yaskapp_staging
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters

# Internal staging MinIO media store. Configure a scoped media-only access key
# for the API rather than reusing MinIO root credentials in a shared staging host.
MINIO_ROOT_USER=replace-with-a-random-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-root-password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=yaskapp-staging-media
S3_ACCESS_KEY_ID=replace-with-media-access-key
S3_SECRET_ACCESS_KEY=replace-with-media-secret
S3_FORCE_PATH_STYLE=true

ACCOUNT_DELETION_ENABLED=false

# Before setting ACCOUNT_DELETION_ENABLED=true, configure all fields below in
# one change. Journal, checkpoint, and media must use three distinct endpoints;
# journal and checkpoint must also be separate accounts/failure domains with
# versioning and 35-day Object Lock in compliance mode.
# ACCOUNT_DELETION_JOURNAL_ENDPOINT=https://replace-with-independent-journal-endpoint
# ACCOUNT_DELETION_JOURNAL_REGION=us-east-1
# ACCOUNT_DELETION_JOURNAL_BUCKET=replace-with-private-staging-journal-bucket
# ACCOUNT_DELETION_JOURNAL_ID=stable-staging-journal-identity
# ACCOUNT_DELETION_JOURNAL_ACCESS_KEY_ID=replace-with-api-journal-key
# ACCOUNT_DELETION_JOURNAL_SECRET_ACCESS_KEY=replace-with-api-journal-secret
# ACCOUNT_DELETION_JOURNAL_HMAC_KEY=replace-with-at-least-32-random-characters
# ACCOUNT_DELETION_JOURNAL_CHECKPOINT_ENDPOINT=https://replace-with-independent-checkpoint-endpoint
# ACCOUNT_DELETION_JOURNAL_CHECKPOINT_REGION=us-east-1
# ACCOUNT_DELETION_JOURNAL_CHECKPOINT_BUCKET=replace-with-private-staging-checkpoint-bucket
# ACCOUNT_DELETION_JOURNAL_CHECKPOINT_ACCESS_KEY_ID=replace-with-api-checkpoint-key
# ACCOUNT_DELETION_JOURNAL_CHECKPOINT_SECRET_ACCESS_KEY=replace-with-api-checkpoint-secret

# Optional. The notification worker expects this file at
# infra/docker/secrets/firebase-service-account.json.
# FIREBASE_PROJECT_ID=replace-with-staging-firebase-project-id
