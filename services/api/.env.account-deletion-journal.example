# Optional legacy independent journal. Not used by the database-only deployment.
# Copy to .env.account-deletion-journal on API hosts. This file contains only
# the runtime journal connection and signing identity; provision the role on
# the separate journal host and use a DNS name covered by its TLS certificate.
ACCOUNT_DELETION_JOURNAL_ENABLED=true
ACCOUNT_DELETION_JOURNAL_DATABASE_URL=postgresql://account_deletion_journal_runtime:replace-with-runtime-password@journal.internal.example:5432/account_deletion_journal?sslmode=verify-full
ACCOUNT_DELETION_JOURNAL_ID=stable-staging-journal-identity
ACCOUNT_DELETION_JOURNAL_HMAC_KEY=replace-with-at-least-32-random-characters
