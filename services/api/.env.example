NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=*

DATABASE_URL=postgres://yaskapp:yaskapp@localhost:5432/yaskapp
REDIS_URL=redis://localhost:6379

JWT_SECRET=development-only-secret

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yaskapp-media
S3_ACCESS_KEY_ID=yaskapp
S3_SECRET_ACCESS_KEY=yaskapp-secret
S3_FORCE_PATH_STYLE=true

ACCOUNT_DELETION_ENABLED=false
# Required as a complete set before enabling account deletion. Use an
# independent object-storage endpoint and private bucket, not the media store.
# ACCOUNT_DELETION_JOURNAL_ENDPOINT=https://journal.example.com
# ACCOUNT_DELETION_JOURNAL_REGION=us-east-1
# ACCOUNT_DELETION_JOURNAL_BUCKET=yaskapp-account-deletion-journal
# ACCOUNT_DELETION_JOURNAL_ACCESS_KEY_ID=replace-me
# ACCOUNT_DELETION_JOURNAL_SECRET_ACCESS_KEY=replace-me
# ACCOUNT_DELETION_JOURNAL_HMAC_KEY=at-least-32-random-characters
