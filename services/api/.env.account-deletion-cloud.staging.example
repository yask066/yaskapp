# Backblaze B2 S3-compatible API: use an Object Lock-enabled bucket and a
# distinct B2 account/bucket from the AWS checkpoint below.
ACCOUNT_DELETION_JOURNAL_ENDPOINT=https://s3.<B2-region>.backblazeb2.com
ACCOUNT_DELETION_JOURNAL_REGION=<B2-region>
ACCOUNT_DELETION_JOURNAL_BUCKET=<private-b2-journal-bucket>
ACCOUNT_DELETION_JOURNAL_ACCESS_KEY_ID=<scoped-api-journal-key-id>
ACCOUNT_DELETION_JOURNAL_SECRET_ACCESS_KEY=<scoped-api-journal-secret>
ACCOUNT_DELETION_JOURNAL_ID=<stable-staging-deployment-id>
ACCOUNT_DELETION_JOURNAL_HMAC_KEY=<at-least-32-random-characters>

# AWS S3 checkpoint bucket, in a separate account/failure domain from B2.
ACCOUNT_DELETION_JOURNAL_CHECKPOINT_ENDPOINT=https://s3.<AWS-region>.amazonaws.com
ACCOUNT_DELETION_JOURNAL_CHECKPOINT_REGION=<AWS-region>
ACCOUNT_DELETION_JOURNAL_CHECKPOINT_BUCKET=<private-aws-checkpoint-bucket>
ACCOUNT_DELETION_JOURNAL_CHECKPOINT_ACCESS_KEY_ID=<scoped-api-checkpoint-key-id>
ACCOUNT_DELETION_JOURNAL_CHECKPOINT_SECRET_ACCESS_KEY=<scoped-api-checkpoint-secret>

# Independent AWS S3 backup bucket, with current and noncurrent expiry <=30d.
STAGING_BACKUP_ENDPOINT=https://s3.<AWS-region>.amazonaws.com
STAGING_BACKUP_REGION=<AWS-region>
STAGING_BACKUP_BUCKET=<private-aws-backup-bucket>
STAGING_BACKUP_ACCESS_KEY_ID=<scoped-backup-check-key-id>
STAGING_BACKUP_SECRET_ACCESS_KEY=<scoped-backup-check-secret>
