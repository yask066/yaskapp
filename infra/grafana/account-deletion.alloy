loki.source.syslog "account_deletion" {
  relabel_rules = loki.relabel.account_deletion.rules

  listener {
    address      = "0.0.0.0:1514"
    protocol     = "tcp"
    syslog_format = "rfc5424"
    labels       = { job = "account-deletion" }
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.relabel "account_deletion" {
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "service"
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_LOKI_TOKEN")
    }
  }
}
