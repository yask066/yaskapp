[Unit]
Description=Yaskapp encrypted PostgreSQL and MinIO backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/local/libexec/yaskapp-backup/staging_backup.py backup
ExecStopPost=/usr/bin/python3 /usr/local/libexec/yaskapp-backup/staging_backup.py resume
TimeoutStartSec=45min
TimeoutStopSec=180
KillMode=control-group
NoNewPrivileges=true
ProtectHome=true
